  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build && node scripts/csp-manifest.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest",
    "test:run": "vitest run",
    "local": "npm run build && tsx scripts/local-doorway.mts",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cuny-ai-lab/cail-client": "6.3.1",
    "@cuny-ai-lab/cail-identity": "5.2.6",
    "nanoid": "^5.1.6",
    "next": "^15.5.29",
    "pdfjs-dist": "^6.5.438",
    "react": "^18",
    "react-dom": "^18",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^27.2.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.0.14",
    "wrangler": "4.147.0"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.32"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
